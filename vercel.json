{
  "version": 2,
  "rewrites": [
    { "source": "/owner", "destination": "/public/owner.html" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/((?!api/).*)", "destination": "/public/index.html" }
  ],
  "crons": [
    { "path": "/api/subscriptions/check-expired", "schedule": "0 0 * * *" }
  ]
}
